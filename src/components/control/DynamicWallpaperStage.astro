---
import { Icon } from "astro-icon/components";

interface Props {
	location: "banner" | "fullscreen";
}

const { location } = Astro.props;
---

<div
	class="sky-dynamic-wallpaper"
	data-sky-dynamic-host={location}
	data-active="false"
	data-ready="false"
	data-in-view="true"
>
	<video
		class="sky-dynamic-wallpaper__video"
		data-sky-scene-video
		muted
		loop
		playsinline
		preload="none"
		disablepictureinpicture
		aria-hidden="true"
	></video>
	<canvas
		class="sky-dynamic-wallpaper__canvas"
		data-sky-scene-canvas
		aria-hidden="true"
	></canvas>
	<div class="sky-dynamic-wallpaper__light" aria-hidden="true"></div>
	<button
		type="button"
		class="sky-dynamic-wallpaper__play"
		data-sky-scene-play
		hidden
	>
		<Icon name="material-symbols:play-arrow-rounded" />
		<span>播放动态壁纸</span>
	</button>
</div>

<style is:global>
	.sky-dynamic-wallpaper {
		position: absolute;
		inset: 0;
		z-index: 1;
		overflow: hidden;
		background: transparent;
		opacity: 0;
		visibility: hidden;
		pointer-events: none;
		isolation: isolate;
		transition:
			opacity 520ms cubic-bezier(0.16, 1, 0.3, 1),
			visibility 520ms step-end;
	}

	.sky-dynamic-wallpaper[data-active="true"] {
		opacity: 1;
		visibility: visible;
		transition:
			opacity 520ms cubic-bezier(0.16, 1, 0.3, 1),
			visibility 0ms step-start;
	}

	.sky-dynamic-wallpaper__video {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		max-width: none;
		object-fit: cover;
		object-position: center;
		background: transparent;
		opacity: 0;
		backface-visibility: hidden;
		transition: opacity 560ms cubic-bezier(0.16, 1, 0.3, 1);
		will-change: opacity;
	}

	.sky-dynamic-wallpaper[data-ready="true"] .sky-dynamic-wallpaper__video {
		opacity: 1;
	}

	.sky-dynamic-wallpaper__canvas,
	.sky-dynamic-wallpaper__light {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		pointer-events: none;
	}

	.sky-dynamic-wallpaper__canvas {
		z-index: 2;
		opacity: 0;
		transition: opacity 300ms ease;
	}

	.sky-dynamic-wallpaper[data-scene="noa"][data-ready="true"]
		.sky-dynamic-wallpaper__canvas,
	.sky-dynamic-wallpaper[data-scene="summer"][data-ready="true"]
		.sky-dynamic-wallpaper__canvas {
		opacity: 1;
	}

	.sky-dynamic-wallpaper__light {
		z-index: 1;
		background:
			radial-gradient(
				circle at var(--sky-scene-light-x, 50%) var(--sky-scene-light-y, 48%),
				rgb(226 232 255 / var(--sky-scene-glow-alpha, 0.04)),
				transparent 36%
			),
			linear-gradient(180deg, rgb(255 255 255 / 0.02), rgb(22 33 63 / 0.08));
		mix-blend-mode: screen;
	}

	.sky-dynamic-wallpaper[data-scene="noa"] .sky-dynamic-wallpaper__light {
		background:
			radial-gradient(
				circle at var(--sky-scene-light-x, 50%) var(--sky-scene-light-y, 48%),
				rgb(226 232 255 / var(--sky-scene-glow-alpha, 0.04)),
				transparent 34%
			),
			radial-gradient(
				circle at 68% 64%,
				rgb(178 199 255 / var(--sky-scene-bass-alpha, 0.015)),
				transparent 43%
			),
			radial-gradient(
				circle at 38% 30%,
				rgb(255 220 244 / var(--sky-scene-mid-alpha, 0.012)),
				transparent 38%
			),
			linear-gradient(180deg, rgb(255 255 255 / 0.02), rgb(22 33 63 / 0.08));
	}

	.sky-dynamic-wallpaper[data-scene="summer"] .sky-dynamic-wallpaper__light {
		inset: -8% -4%;
		background:
			linear-gradient(
				112deg,
				transparent 20%,
				rgb(196 244 255 / 0.04) 32%,
				rgb(216 255 235 / 0.18) 43%,
				transparent 55%
			),
			linear-gradient(
				104deg,
				transparent 37%,
				rgb(150 226 255 / 0.12) 50%,
				transparent 62%
			);
		opacity: 0.62;
		transform-origin: 56% 8%;
		animation: sky-summer-lightshaft 7.5s ease-in-out infinite alternate;
	}

	@keyframes sky-summer-lightshaft {
		from {
			transform: translate3d(-0.8%, -0.4%, 0) rotate(-0.35deg) scale(1.02);
			opacity: 0.42;
		}

		to {
			transform: translate3d(0.8%, 0.35%, 0) rotate(0.35deg) scale(1.04);
			opacity: 0.7;
		}
	}

	.sky-dynamic-wallpaper__play {
		position: absolute;
		left: max(1rem, env(safe-area-inset-left));
		bottom: max(1rem, env(safe-area-inset-bottom));
		z-index: 4;
		display: inline-flex;
		min-height: 2.75rem;
		align-items: center;
		gap: 0.42rem;
		padding: 0.65rem 0.85rem;
		border: 1px solid rgb(255 255 255 / 0.24);
		border-radius: 0.75rem;
		background: rgb(9 18 35 / 0.72);
		color: white;
		font-size: 0.78rem;
		font-weight: 720;
		box-shadow: 0 10px 30px rgb(4 10 24 / 0.28);
		backdrop-filter: blur(14px) saturate(130%);
		-webkit-backdrop-filter: blur(14px) saturate(130%);
		cursor: pointer;
		pointer-events: auto;
		transition:
			background-color 150ms ease,
			transform 150ms ease;
	}

	.sky-dynamic-wallpaper__play[hidden] {
		display: none;
	}

	.sky-dynamic-wallpaper__play:hover {
		background: rgb(9 18 35 / 0.86);
	}

	.sky-dynamic-wallpaper__play:active {
		transform: scale(0.97);
	}

	.sky-dynamic-wallpaper__play:focus-visible {
		outline: 2px solid white;
		outline-offset: 3px;
	}

	.sky-dynamic-wallpaper__play svg {
		width: 1.1rem;
		height: 1.1rem;
	}

	html.sky-scene-changing .sky-dynamic-wallpaper {
		opacity: 0.24;
	}

	html.sky-motion-paused .sky-dynamic-wallpaper__video {
		visibility: hidden;
	}

	@media (width < 768px), (hover: none), (pointer: coarse) {
		.sky-dynamic-wallpaper__video {
			inset: 0;
			width: 100%;
			height: 100%;
			transform: none;
			will-change: opacity;
		}

		.sky-dynamic-wallpaper__canvas {
			display: none;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.sky-dynamic-wallpaper,
		.sky-dynamic-wallpaper__video,
		.sky-dynamic-wallpaper__canvas,
		.sky-dynamic-wallpaper__play {
			transition: none;
		}

		.sky-dynamic-wallpaper__canvas,
		.sky-dynamic-wallpaper__light {
			display: none;
		}
	}
</style>
