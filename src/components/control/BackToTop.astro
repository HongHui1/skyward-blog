---
import FloatingButton from "@components/common/FloatingButton.astro";
---

<FloatingButton
	id="back-to-top-btn"
	icon="material-symbols:keyboard-arrow-up-rounded"
	ariaLabel="Back to Top"
	onclick="backToTop()"
	class="hide"
>
	<svg class="genesis-ring" viewBox="0 0 40 40" aria-hidden="true">
		<circle cx="20" cy="20" r="18" pathLength="100"></circle>
	</svg>
</FloatingButton>

<script is:raw is:inline>
	function backToTop() {
		window.scroll({ top: 0, behavior: "smooth" });
	}
</script>
