---
import type { MarkdownHeading } from "astro";
import { Icon } from "astro-icon/components";

import { musicPlayerConfig, siteConfig } from "../../config";
import { url } from "../../utils/url-utils";
import FloatingTOC from "../features/toc/FloatingTOC.astro";
import MusicFabButton from "./MusicFabButton.svelte";

interface Props {
	headings?: MarkdownHeading[];
}

const { headings = [] } = Astro.props;
const homeHref = url("/");
---

<!--
	SkyCity navigation dock. The controls proxy the existing navbar components so
	search, theme and menu keep one source of truth across Swup page changes.
-->
<nav class="sky-dock sky-dock--desktop" aria-label="SkyCity 快捷控制">
	<a
		class="sky-dock__action"
		href={homeHref}
		data-dock-label="首页"
		aria-label="返回首页"
	>
		<Icon name="material-symbols:home-outline-rounded" />
	</a>
	<button
		type="button"
		class="sky-dock__action"
		data-sky-dock-action="search"
		data-dock-label="搜索"
		aria-label="打开搜索"
	>
		<Icon name="material-symbols:search-rounded" />
	</button>
	{
		musicPlayerConfig.enable && musicPlayerConfig.showFloatingPlayer && (
			<div class="sky-dock__action sky-dock__music" data-dock-label="音乐">
				<MusicFabButton client:idle />
			</div>
		)
	}
	<button
		type="button"
		class="sky-dock__action"
		data-sky-dock-action="theme"
		data-dock-label="主题"
		aria-label="切换明暗主题"
	>
		<Icon name="material-symbols:contrast-rounded" />
	</button>
	<button
		type="button"
		class="sky-dock__action"
		data-sky-dock-action="scene"
		data-dock-label="场景"
		aria-label="选择沉浸场景"
	>
		<Icon name="material-symbols:landscape-outline-rounded" />
	</button>
	{
		siteConfig.toc.enable && siteConfig.toc.floating && (
			<div class="sky-dock__action dock-native" data-dock-label="目录">
				<FloatingTOC headings={headings} />
			</div>
		)
	}
	<button
		type="button"
		class="sky-dock__action sky-dock__top is-hidden"
		data-sky-dock-action="top"
		data-dock-label="顶部"
		aria-label="返回页面顶部"
	>
		<svg class="genesis-ring" viewBox="0 0 40 40" aria-hidden="true">
			<circle cx="20" cy="20" r="18" pathLength="100"></circle>
		</svg>
		<Icon name="material-symbols:keyboard-arrow-up-rounded" />
	</button>
</nav>

<nav class="sky-dock sky-dock--mobile" aria-label="SkyCity 移动快捷栏">
	<a class="sky-dock__action" href={homeHref} aria-label="返回首页">
		<Icon name="material-symbols:home-outline-rounded" />
		<span>首页</span>
	</a>
	<button
		type="button"
		class="sky-dock__action"
		data-sky-dock-action="search"
		aria-label="打开搜索"
	>
		<Icon name="material-symbols:search-rounded" />
		<span>搜索</span>
	</button>
	{
		musicPlayerConfig.enable && musicPlayerConfig.showFloatingPlayer && (
			<div class="sky-dock__action sky-dock__music">
				<MusicFabButton client:idle />
				<span>音乐</span>
			</div>
		)
	}
	<button
		type="button"
		class="sky-dock__action"
		data-sky-dock-action="theme"
		aria-label="切换明暗主题"
	>
		<Icon name="material-symbols:contrast-rounded" />
		<span>主题</span>
	</button>
	<button
		type="button"
		class="sky-dock__action sky-dock__context sky-dock__scene-context"
		data-sky-dock-action="scene"
		aria-label="选择沉浸场景"
	>
		<Icon name="material-symbols:landscape-outline-rounded" />
		<span>场景</span>
	</button>
	<button
		type="button"
		class="sky-dock__action sky-dock__context sky-dock__toc-context is-hidden"
		data-sky-dock-action="toc"
		aria-label="打开文章目录"
	>
		<Icon name="material-symbols:format-list-bulleted-rounded" />
		<span>目录</span>
	</button>
	<button
		type="button"
		class="sky-dock__action"
		data-sky-dock-action="menu"
		aria-label="打开导航菜单"
	>
		<Icon name="material-symbols:menu-rounded" />
		<span>菜单</span>
	</button>
</nav>

<style>
	:global(:root) {
		--sky-dock-right: 1rem;
		--sky-dock-bottom: 50%;
		--sky-dock-size: 3rem;
		--fab-button-size: 3rem;
	}

	.sky-dock {
		position: fixed;
		z-index: 56;
		pointer-events: auto;
		background: color-mix(in oklch, var(--card-bg) 78%, transparent);
		box-shadow: 0 14px 42px rgb(15 23 42 / 0.18);
		backdrop-filter: blur(18px) saturate(135%);
		-webkit-backdrop-filter: blur(18px) saturate(135%);
	}

	.sky-dock--desktop {
		right: var(--sky-dock-right);
		bottom: var(--sky-dock-bottom);
		display: flex;
		flex-direction: column;
		gap: 0.24rem;
		padding: 0.36rem;
		border-radius: 1rem;
		transform: translateY(50%);
	}

	.sky-dock--mobile {
		display: none;
	}

	.sky-dock__action {
		position: relative;
		display: flex;
		align-items: center;
		justify-content: center;
		width: var(--sky-dock-size);
		height: var(--sky-dock-size);
		min-width: 0;
		padding: 0;
		border: 0;
		border-radius: 0.75rem;
		background: transparent;
		color: var(--content-meta);
		cursor: pointer;
		text-decoration: none;
		transition:
			color 180ms ease,
			background-color 180ms ease,
			transform 220ms cubic-bezier(0.16, 1, 0.3, 1);
	}

	.sky-dock__action > :global(svg) {
		width: 1.28rem;
		height: 1.28rem;
	}

	.sky-dock__action:is(:hover, :focus-visible) {
		background: color-mix(in oklch, var(--primary) 12%, transparent);
		color: var(--primary);
		transform: translateX(-0.12rem);
	}

	.sky-dock__action:active {
		transform: translateX(-0.12rem) scale(0.92);
	}

	.sky-dock__action:focus-visible {
		outline: 2px solid var(--primary);
		outline-offset: 2px;
	}

	.sky-dock--desktop .sky-dock__action::before {
		content: attr(data-dock-label);
		position: absolute;
		right: calc(100% + 0.7rem);
		top: 50%;
		padding: 0.34rem 0.58rem;
		border-radius: 0.55rem;
		background: rgb(15 23 42 / 0.88);
		color: white;
		font-size: 0.72rem;
		font-weight: 650;
		line-height: 1;
		white-space: nowrap;
		opacity: 0;
		pointer-events: none;
		transform: translate3d(0.35rem, -50%, 0);
		transition:
			opacity 140ms ease,
			transform 200ms cubic-bezier(0.16, 1, 0.3, 1);
	}

	.sky-dock--desktop .sky-dock__action:is(:hover, :focus-within)::before {
		opacity: 1;
		transform: translate3d(0, -50%, 0);
	}

	.sky-dock__music {
		position: relative;
		flex-direction: column;
	}

	:global(.sky-dock .music-fab),
	:global(.sky-dock #floating-toc-btn) {
		width: var(--sky-dock-size) !important;
		height: var(--sky-dock-size) !important;
		min-width: var(--sky-dock-size) !important;
		min-height: var(--sky-dock-size) !important;
		padding: 0 !important;
		border: 0 !important;
		border-radius: 0.75rem !important;
		background: transparent !important;
		box-shadow: none !important;
		color: inherit !important;
	}

	:global(.sky-dock .music-fab:hover),
	:global(.sky-dock #floating-toc-btn:hover) {
		background: color-mix(in oklch, var(--primary) 12%, transparent) !important;
		color: var(--primary) !important;
	}

	:global(.dock-native:has(#floating-toc-btn.hide)),
	.sky-dock__top.is-hidden,
	.sky-dock__context.is-hidden {
		display: none;
	}

	@media (width < 768px) {
		:global(:root) {
			--sky-dock-size: 2.9rem;
			--fab-button-size: 2.9rem;
		}

		.sky-dock--desktop {
			right: 0.5rem;
			bottom: calc(max(0.55rem, env(safe-area-inset-bottom)) + 4.5rem);
			display: block;
			width: 0;
			height: 0;
			padding: 0;
			background: transparent;
			box-shadow: none;
			backdrop-filter: none;
			-webkit-backdrop-filter: none;
			transform: none;
		}

		.sky-dock--desktop > :not(.dock-native) {
			display: none;
		}

		.sky-dock--desktop .dock-native {
			position: absolute;
			right: 0;
			bottom: 0;
			width: 0;
			height: 0;
		}

		:global(.sky-dock--desktop #floating-toc-btn) {
			display: none !important;
		}

		.sky-dock--mobile {
			left: 50%;
			bottom: max(0.55rem, env(safe-area-inset-bottom));
			display: grid;
		grid-template-columns: repeat(6, minmax(0, 1fr));
			width: min(calc(100vw - 1rem), 24rem);
			padding: 0.38rem 0.42rem 0.32rem;
			border-radius: 1rem;
			transform: translateX(-50%);
			transition:
				opacity 180ms ease-out,
				transform 220ms cubic-bezier(0.16, 1, 0.3, 1);
			will-change: transform, opacity;
		}

		.sky-dock--mobile[data-hidden="true"] {
			opacity: 0;
			pointer-events: none;
			transform: translate3d(-50%, calc(100% + 1.25rem), 0);
		}

		.sky-dock--mobile .sky-dock__action {
			width: 100%;
			height: 3.05rem;
			min-height: 44px;
			gap: 0.08rem;
			flex-direction: column;
			border-radius: 0.72rem;
			font-size: 0.61rem;
			font-weight: 650;
			line-height: 1;
		}

		.sky-dock--mobile .sky-dock__action > span {
			color: rgb(15 23 42 / 0.74);
		}

		:global(:root.dark) .sky-dock--mobile .sky-dock__action > span {
			color: rgb(255 255 255 / 0.8);
		}

		.sky-dock--mobile .sky-dock__action:is(:hover, :focus-visible),
		.sky-dock--mobile .sky-dock__action:active {
			transform: none;
		}

		.sky-dock--mobile .sky-dock__music {
			color: var(--primary);
		}

		:global(.sky-dock--mobile .sky-dock__music > astro-island) {
			display: contents;
		}

		:global(.sky-dock--mobile .music-fab) {
			position: absolute !important;
			inset: 0 !important;
			width: 100% !important;
			height: 100% !important;
			min-height: 44px !important;
		}

		:global(.sky-dock--mobile .music-fab__icon) {
			font-size: 1.25rem !important;
			transform: translateY(-0.42rem);
		}

		.sky-dock--mobile .sky-dock__music > span {
			position: absolute;
			bottom: 0.34rem;
			pointer-events: none;
		}

		:global(#navbar #search-container),
		:global(#navbar #scheme-switch),
		:global(#navbar #nav-menu-switch) {
			display: none !important;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.sky-dock--mobile,
		.sky-dock__action,
		.sky-dock__action::before {
			transition: none;
		}
	}
</style>

<script is:inline>
	(() => {
		if (window.__skyDockControllerInstalled) return;
		window.__skyDockControllerInstalled = true;
		let lastScrollY = window.scrollY;
		let scrollFrame = 0;
		let musicExpanded = false;

		const mobileDock = document.querySelector(".sky-dock--mobile");
		const isPanelOpen = () => {
			const search = document.getElementById("search-panel");
			const menu = document.getElementById("nav-menu-panel");
			const formControl = document.activeElement?.matches?.(
				'input, textarea, select, [contenteditable="true"]',
			);
			return Boolean(
				musicExpanded ||
				document.documentElement.classList.contains("sky-scene-panel-open") ||
				document.querySelector(".floating-toc-panel.show") ||
				(search && !search.classList.contains("float-panel-closed")) ||
				(menu && !menu.classList.contains("float-panel-closed")) ||
				formControl,
			);
		};

		const showMobileDock = () => mobileDock?.setAttribute("data-hidden", "false");
		const updateMobileDock = () => {
			scrollFrame = 0;
			if (!mobileDock || window.innerWidth >= 768 || isPanelOpen()) {
				showMobileDock();
				lastScrollY = window.scrollY;
				return;
			}
			const current = window.scrollY;
			const delta = current - lastScrollY;
			if (current < 96 || delta < -7) {
				showMobileDock();
			} else if (current > 140 && delta > 7) {
				mobileDock.setAttribute("data-hidden", "true");
			}
			lastScrollY = current;
		};

		const scheduleMobileDockUpdate = () => {
			if (!scrollFrame) scrollFrame = window.requestAnimationFrame(updateMobileDock);
		};

		const updateDockContext = () => {
			const hasArticleTOC = Boolean(
				document.getElementById("post-container") &&
				!document.getElementById("floating-toc-btn")?.classList.contains("hide"),
			);
			document
				.querySelectorAll(".sky-dock__scene-context")
				.forEach((button) => button.classList.toggle("is-hidden", hasArticleTOC));
			document
				.querySelectorAll(".sky-dock__toc-context")
				.forEach((button) => button.classList.toggle("is-hidden", !hasArticleTOC));
			showMobileDock();
		};

		const updateTopControl = () => {
			document.querySelectorAll(".sky-dock__top").forEach((button) => {
				button.classList.toggle("is-hidden", window.scrollY < 480);
			});
		};

		const handleDockAction = (event) => {
			const target = event.currentTarget;
			const action = target?.getAttribute("data-sky-dock-action");
			event.stopPropagation();

			if (action === "search") {
				if (window.matchMedia("(min-width: 1024px)").matches) {
					document.getElementById("search-input-desktop")?.focus();
				} else {
					const panel = document.getElementById("search-panel");
					const isOpening = panel?.classList.contains("float-panel-closed");
					panel?.classList.toggle("float-panel-closed");
					if (isOpening) {
						const focusSearch = () =>
							document
								.querySelector("#search-bar-inside input")
								?.focus({ preventScroll: true });
						focusSearch();
						window.setTimeout(focusSearch, 260);
					}
					if (isOpening && typeof window.loadPagefind === "function") {
						window.loadPagefind();
					}
				}
				return;
			}

			if (action === "theme") {
				document.getElementById("scheme-switch")?.click();
				return;
			}

			if (action === "scene") {
				document.dispatchEvent(new CustomEvent("sky-scene-panel-toggle"));
				showMobileDock();
				return;
			}

			if (action === "toc") {
				document.querySelector("#floating-toc-btn > button")?.click();
				showMobileDock();
				return;
			}

			if (action === "menu") {
				document
					.getElementById("nav-menu-panel")
					?.classList.toggle("float-panel-closed");
				return;
			}

			if (action === "top") {
				const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
				window.scrollTo({ top: 0, behavior: reduced ? "auto" : "smooth" });
			}
		};

		document
			.querySelectorAll("[data-sky-dock-action]")
			.forEach((button) => button.addEventListener("click", handleDockAction));

		window.addEventListener("scroll", updateTopControl, { passive: true });
		window.addEventListener("scroll", scheduleMobileDockUpdate, { passive: true });
		window.addEventListener("resize", scheduleMobileDockUpdate, { passive: true });
		window.addEventListener("music-sidebar:state", (event) => {
			musicExpanded = Boolean(event.detail?.isExpanded);
			showMobileDock();
		});
		document.addEventListener("focusin", showMobileDock);
		document.addEventListener("sky-toc:state", showMobileDock);
		document.addEventListener("sky-toc:ready", updateDockContext);
		document.addEventListener(
			"DOMContentLoaded",
			() => window.setTimeout(updateDockContext, 0),
			{ once: true },
		);
		document.addEventListener("swup:page:view", () => {
			updateTopControl();
			window.setTimeout(updateDockContext, 0);
		});
		updateTopControl();
		updateDockContext();
	})();
</script>
