---
import { Icon } from "astro-icon/components";
import { wallpaperScenes } from "@/config/sceneConfig";

interface Props {
	title?: string;
	subtitle?: string | string[];
}
const { title = "我的SkyCity", subtitle } = Astro.props;
const currentScene = wallpaperScenes.find((scene) => scene.id === "noa")!;
const prefix = title.endsWith("SkyCity") ? title.slice(0, -7) : "";
const description = Array.isArray(subtitle) ? subtitle[0] : subtitle;
---

<section class="sky-opening" aria-label="欢迎来到 SkyCity">
	<div class="sky-opening__body">
		<div class="sky-opening__introduction">
			<h1 class="sky-opening__title">{prefix && <span>{prefix}</span>}{prefix ? "SkyCity" : title}<i aria-hidden="true">.</i></h1>
			<p class="sky-opening__description">{description}</p>
			<div class="sky-opening__actions">
				<a class="sky-opening__read" href="#sky-journal"><span>走进我的日常</span><Icon name="material-symbols:arrow-forward-rounded" /></a>
				<button type="button" class="sky-opening__immerse" data-sky-hero-immerse><Icon name="material-symbols:fullscreen-rounded" /><span>只看风景</span></button>
			</div>
			<p class="sky-opening__signature">cloudward <span aria-hidden="true">/</span> 生活 · 学习 · 远方</p>
		</div>
		<div class="sky-opening__scenes">
			<div class="sky-opening__previews" role="group" aria-label="切换首页壁纸">
				{wallpaperScenes.map((scene, index) => (
					<button type="button" class="sky-opening__scene" data-sky-scene-select={scene.id} aria-pressed={scene.id === "noa"} aria-label={`切换壁纸：${scene.name}`} style={`--scene-angle: ${(index - 1) * 7}deg`}>
						<img src={scene.preview} alt="" width="80" height="104" loading="lazy" decoding="async" />
						<span class="sky-opening__scene-check" aria-hidden="true"><Icon name="material-symbols:check-rounded" /></span>
					</button>
				))}
			</div>
			<button type="button" class="sky-opening__scene-info" data-sky-open-scenes><span data-sky-current-scene>{currentScene.name}</span><Icon name="material-symbols:arrow-outward-rounded" /></button>
			<p>换一片天空，换一种心情。</p>
		</div>
	</div>
	<div class="sky-opening__bottom">
		<span class="sky-opening__note"><span aria-hidden="true"></span> 随风而行，随心记录</span>
		<a href={currentScene.url} data-sky-current-author target="_blank" rel="noopener noreferrer">{currentScene.credit}</a>
	</div>
</section>

<style>
	.sky-opening { position: absolute; inset: 0; color: #fff; text-align: left; pointer-events: none; }
	.sky-opening__body { position: absolute; bottom: clamp(9rem, 18svh, 12rem); left: max(7.5vw, calc((100vw - 1160px) / 2)); right: max(8vw, calc((100vw - 1160px) / 2)); display: grid; grid-template-columns: minmax(0, 1fr) 15rem; gap: 3rem; align-items: end; }
	.sky-opening__introduction { max-width: 44rem; }
	.sky-opening__title { display: flex; align-items: baseline; gap: .18em; margin: 0; color: #fff; font-family: var(--font-display), var(--font-body), var(--font-cjk), sans-serif; font-size: clamp(3.7rem, 7.5vw, 6rem); font-weight: 700; line-height: 1.08; letter-spacing: -.035em; text-shadow: 0 4px 24px rgb(7 17 39 / .16); }
	.sky-opening__title > span { font-family: var(--font-body), var(--font-cjk), sans-serif; font-size: .3em; letter-spacing: 0; }
	.sky-opening__title i { color: #c8dfff; font-style: normal; margin-left: -.16em; }
	.sky-opening__description { max-width: 27em; margin: 1.35rem 0 1.8rem; color: #f5f7ff; font-size: clamp(.98rem, 1.35vw, 1.1rem); line-height: 1.9; text-wrap: pretty; }
	.sky-opening__actions { display: flex; flex-wrap: wrap; align-items: center; gap: 1.1rem; pointer-events: auto; }
	.sky-opening__actions a, .sky-opening__actions button { display: inline-flex; align-items: center; justify-content: center; gap: 1rem; min-height: 48px; padding: .7rem 1.15rem; border-radius: 12px; font-size: .86rem; font-weight: 600; cursor: pointer; transition: transform 220ms cubic-bezier(.16,1,.3,1), background-color 180ms ease; }
	.sky-opening__read { color: #15253b; background: #fff; box-shadow: 0 8px 24px rgb(4 15 32 / .12); }
	.sky-opening__immerse { color: #fff; border: 1px solid rgb(255 255 255 / .5); background: rgb(16 29 48 / .2); }
	.sky-opening :global(svg) { width: 1.2rem; height: 1.2rem; flex-shrink: 0; }
	.sky-opening__signature { display: flex; align-items: center; gap: .7rem; margin-top: 1.7rem; font-size: .72rem; color: #e2eafa; }
	.sky-opening__signature > span { opacity: .6; }
	.sky-opening__scenes { pointer-events: auto; justify-self: end; width: 15rem; padding: 1rem .5rem 0; }
	.sky-opening__previews { display: flex; justify-content: center; gap: .45rem; padding-block: 1rem; }
	.sky-opening__scene { position: relative; flex: 0 0 4.25rem; height: 5.6rem; padding: 3px; border-radius: 10px; background: rgb(255 255 255 / .4); transform: rotate(var(--scene-angle)); cursor: pointer; transition: transform 260ms cubic-bezier(.16,1,.3,1), background-color 180ms ease; box-shadow: 0 8px 22px rgb(6 19 41 / .25); }
	.sky-opening__scene img { height: 100%; width: 100%; object-fit: cover; border-radius: 7px; }
	.sky-opening__scene[aria-pressed="true"] { background: #fff; transform: translateY(-.5rem); }
	.sky-opening__scene-check { position: absolute; bottom: -.2rem; right: -.2rem; display: grid; place-items: center; width: 1.3rem; height: 1.3rem; border-radius: 50%; background: #fff; color: #193c63; opacity: 0; }
	.sky-opening__scene-check :global(svg) { width: 1rem; height: 1rem; }
	.sky-opening__scene[aria-pressed="true"] .sky-opening__scene-check { opacity: 1; }
	.sky-opening__scene-info { width: 100%; display: flex; align-items: center; justify-content: space-between; min-height: 44px; color: #fff; font-size: 1rem; border-bottom: 1px solid rgb(255 255 255 / .38); cursor: pointer; }
	.sky-opening__scenes > p { margin-top: .7rem; font-size: .74rem; color: #e2eafa; }
	.sky-opening__bottom { position: absolute; left: max(7.5vw, calc((100vw - 1160px) / 2)); right: max(8vw, calc((100vw - 1160px) / 2)); bottom: 2rem; display: flex; align-items: center; justify-content: space-between; gap: 1.5rem; font-size: 11px; }
	.sky-opening__bottom > a { color: #fff; pointer-events: auto; min-height: 36px; display: flex; align-items: center; text-underline-offset: 4px; }
	.sky-opening__bottom > a:hover { text-decoration: underline; }
	.sky-opening__note { display: flex; align-items: center; gap: .6rem; white-space: nowrap; }
	.sky-opening__note > span { width: 5px; height: 5px; border-radius: 50%; background: #c8dfff; }
	.sky-opening :is(a,button):focus-visible { outline: 2px solid #fff; outline-offset: 5px; }
	@media (hover:hover) and (pointer:fine) {
		.sky-opening__scene:hover { transform: translateY(-.8rem) rotate(0); background: #fff; }
		.sky-opening__actions :is(a,button):hover { transform: translateY(-3px); }
		.sky-opening__immerse:hover { background: rgb(16 29 48 / .45); }
	}
	@media (max-width: 800px) {
		.sky-opening__body { left: 7vw; right: 7vw; bottom: 10rem; grid-template-columns: 1fr; gap: 1.3rem; }
		.sky-opening__title { font-size: clamp(3rem, 12vw, 5.5rem); }
		.sky-opening__description { max-width: 24em; margin: 1rem 0 1.3rem; font-size: .94rem; }
		.sky-opening__scenes { display: flex; align-items: center; flex-wrap: wrap; column-gap: 1rem; width: 100%; justify-self: start; padding: 0; }
		.sky-opening__previews { gap: .3rem; padding: .6rem 0; }
		.sky-opening__scene { flex-basis: 2.6rem; width: 2.6rem; height: 3.4rem; border-radius: 7px; padding: 2px; }
		.sky-opening__scene img { border-radius: 5px; }
		.sky-opening__scene-info { width: auto; gap: 1rem; border-bottom: 0; font-size: .8rem; }
		.sky-opening__scenes > p { display: none; }
		.sky-opening__signature { margin-top: 1.2rem; }
		.sky-opening__bottom { left: 7vw; right: 7vw; bottom: 5.5rem; display: block; }
		.sky-opening__note { display: none; }
		.sky-opening__bottom > a { max-width: 90%; line-height: 1.6; }
	}
	@media (max-height: 720px) and (min-width: 801px) { .sky-opening__body { bottom: 7rem; } }
	@media (max-height: 740px) and (max-width: 800px) {
		.sky-opening__body { bottom: 8rem; gap: .7rem; }
		.sky-opening__description { margin: .8rem 0; }
		.sky-opening__signature { display: none; }
	}
	@media (prefers-reduced-motion: reduce) {
		.sky-opening__scene, .sky-opening__actions :is(a,button) { transition: none; }
	}
</style>
