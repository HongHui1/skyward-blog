---
import { Icon } from "astro-icon/components";
import album from "../../../../public/images/albums/nanjing/info.json";
import { url } from "@/utils/url-utils";

const selected = [2, 1, 5, 9, 13, 14];
const photos = selected
	.map((index) => album.photos[index])
	.filter(Boolean)
	.map((photo) => ({
		...photo,
		src: url(photo.src),
	}));
const first = photos[0];
const galleryHref = url("/albums/nanjing/");
---

<sky-travel-window id="sky-travel" class="travel-window" aria-labelledby="travel-window-title">
	<header class="travel-window__header">
		<div><h2 id="travel-window-title">把风景，装进记忆里。</h2><p>随风而行 · 南京</p></div>
		<a class="travel-window__album" href={galleryHref}>完整相册 <span>{album.photos.length} 张</span><Icon name="material-symbols:arrow-outward-rounded" /></a>
	</header>
	<div class="travel-window__viewer">
		<a href={galleryHref} class="travel-window__image-link" aria-label="打开南京旅行相册">
			<img data-travel-main src={first.src} alt={first.alt} width="1200" height="800" loading="lazy" decoding="async" />
			<span class="travel-window__view"><Icon name="material-symbols:open-in-full-rounded" /><span>走进相册</span></span>
		</a>
		<div class="travel-window__frame" aria-hidden="true"><span></span><span></span><span></span><span></span></div>
		<div class="travel-window__caption" aria-live="polite" aria-atomic="true"><p data-travel-caption>{first.description || first.alt}</p><span data-travel-count>01 / {String(photos.length).padStart(2,"0")}</span></div>
		<div class="travel-window__controls" hidden data-travel-controls>
			<button type="button" data-travel-step="-1" aria-label="上一张旅行照片"><Icon name="material-symbols:arrow-back-rounded" /></button>
			<button type="button" data-travel-step="1" aria-label="下一张旅行照片"><Icon name="material-symbols:arrow-forward-rounded" /></button>
		</div>
		<span class="travel-window__location"><Icon name="material-symbols:location-on-outline-rounded" />南京，2026 年 1 月</span>
		<span class="travel-window__loading" role="status" hidden data-travel-loading>照片加载中…</span>
	</div>
	<div class="travel-window__bottom">
		<p class="travel-window__note">从梧桐大道走到秦淮灯火，<br />总有一些瞬间，值得回头再看。</p>
		<div class="travel-window__thumbnails" role="group" aria-label="选择旅行照片" hidden data-travel-controls>
			{photos.map((photo,index) => (
				<button type="button" data-travel-index={index} aria-pressed={index === 0} aria-label={`第 ${index+1} 张：${photo.alt}`}>
					<img src={photo.src} alt="" width="76" height="60" loading="lazy" decoding="async" />
				</button>
			))}
		</div>
	</div>
	<script is:inline type="application/json" data-travel-photos set:html={JSON.stringify(photos).replace(/</g, "\\u003c")} />
</sky-travel-window>

<script>
	import "@/scripts/travel-window";
</script>

<style>
	.travel-window { display: block; margin: 3.7rem 0 4rem; scroll-margin-top: 7rem; }
	.travel-window__header { display: flex; align-items: center; justify-content: space-between; gap: 1.5rem; margin-bottom: 1.3rem; padding-inline: .25rem; }
	.travel-window__header h2 { margin: 0; font-size: clamp(1.45rem, 2.5vw, 2rem); color: var(--sky-ink); font-weight: 700; line-height: 1.5; letter-spacing: -.02em; text-wrap: balance; }
	.travel-window__header p { margin: .5rem 0 0; color: var(--content-meta); font-size: .83rem; }
	.travel-window__album { display: inline-flex; align-items: center; gap: .65rem; min-height: 44px; flex-shrink: 0; color: var(--sky-ink); font-size: .8rem; }
	.travel-window__album span { color: var(--content-meta); font-size: .7rem; }
	.travel-window :global(svg) { width: 1.1rem; height: 1.1rem; flex-shrink: 0; }
	.travel-window__viewer { position: relative; aspect-ratio: 16 / 10; isolation: isolate; background: #17232c; border-radius: 14px; overflow: hidden; }
	.travel-window__image-link { display: block; width: 100%; height: 100%; touch-action: pan-y; }
	.travel-window__image-link > img { width: 100%; height: 100%; object-fit: cover; }
	.travel-window__viewer::after { content: ""; position: absolute; inset: 50% 0 0; pointer-events: none; background: linear-gradient(transparent, rgb(8 16 27 / .86)); }
	.travel-window__frame { position: absolute; inset: 1.35rem; pointer-events: none; opacity: .7; }
	.travel-window__frame span { position: absolute; width: 1.2rem; height: 1.2rem; border-color: #fff; border-style: solid; border-width: 0; }
	.travel-window__frame span:nth-child(1) { top: 0; left: 0; border-width: 1px 0 0 1px; }
	.travel-window__frame span:nth-child(2) { top: 0; right: 0; border-width: 1px 1px 0 0; }
	.travel-window__frame span:nth-child(3) { bottom: 0; left: 0; border-width: 0 0 1px 1px; }
	.travel-window__frame span:nth-child(4) { bottom: 0; right: 0; border-width: 0 1px 1px 0; }
	.travel-window__location { position: absolute; top: 2rem; left: 2rem; display: flex; align-items: center; gap: .4rem; color: #fff; font-size: .7rem; padding: .45rem .65rem; border-radius: 6px; background: rgb(11 22 33 / .66); pointer-events: none; }
	.travel-window__caption { position: absolute; bottom: 2.1rem; left: 2.2rem; right: 9rem; z-index: 1; color: #fff; pointer-events: none; }
	.travel-window__caption p { margin: 0 0 .65rem; font-size: clamp(1rem, 2.1vw, 1.45rem); line-height: 1.5; }
	.travel-window__caption > span { font-family: var(--font-display), sans-serif; font-variant-numeric: tabular-nums; font-size: .73rem; color: #d9e5ed; letter-spacing: .07em; }
	.travel-window__controls { position: absolute; right: 2.1rem; bottom: 2.2rem; display: flex; gap: .55rem; z-index: 2; }
	.travel-window__controls button { display: grid; place-items: center; width: 44px; height: 44px; color: #fff; border: 1px solid rgb(255 255 255 / .58); border-radius: 50%; background: rgb(18 28 37 / .22); cursor: pointer; transition: background-color 180ms ease, transform 220ms cubic-bezier(.16,1,.3,1); }
	.travel-window__controls button:hover { background: rgb(255 255 255 / .2); }
	.travel-window__controls button:active { transform: scale(.94); }
	.travel-window__view { position: absolute; left: 50%; top: 50%; display: flex; align-items: center; gap: .5rem; transform: translate(-50%,-40%); padding: .7rem 1rem; border-radius: 10px; color: #fff; font-size: .8rem; background: rgb(11 22 33 / .7); opacity: 0; transition: opacity 180ms ease, transform 220ms cubic-bezier(.16,1,.3,1); }
	.travel-window__image-link:focus-visible .travel-window__view { opacity: 1; transform: translate(-50%,-50%); }
	.travel-window__bottom { display: flex; align-items: center; justify-content: space-between; gap: 1.5rem; padding: 1.2rem .25rem; }
	.travel-window__note { margin: 0; font-size: .8rem; line-height: 1.9; color: var(--content-meta); }
	.travel-window__thumbnails { display: flex; gap: .4rem; padding: .25rem; overflow-x: auto; scrollbar-width: thin; }
	.travel-window__thumbnails button { flex: 0 0 3.4rem; height: 2.9rem; padding: 3px; border-radius: 7px; background: transparent; opacity: .5; cursor: pointer; transition: opacity 180ms ease, transform 220ms cubic-bezier(.16,1,.3,1); }
	.travel-window__thumbnails button[aria-pressed="true"] { opacity: 1; background: var(--primary); }
	.travel-window__thumbnails button:hover { opacity: 1; }
	.travel-window__thumbnails img { width: 100%; height: 100%; object-fit: cover; border-radius: 4px; }
	.travel-window__loading { position: absolute; inset: auto 0 5rem; z-index: 2; text-align: center; color: #fff; font-size: .8rem; text-shadow: 0 1px 8px #000; }
	.travel-window [hidden] { display: none; }
	.travel-window :is(a,button):focus-visible { outline: 2px solid var(--primary); outline-offset: 4px; }
	.travel-window__viewer :is(a,button):focus-visible { outline-color: #fff; outline-offset: -5px; }
	@media (hover:hover) and (pointer:fine) { .travel-window__image-link:hover .travel-window__view { opacity: 1; transform: translate(-50%,-50%); } }
	@media (max-width: 700px) {
		.travel-window { margin-block: 2.75rem; }
		.travel-window__header { gap: 1rem; }
		.travel-window__header h2 { font-size: 1.3rem; }
		.travel-window__album { font-size: .75rem; gap: .3rem; }
		.travel-window__album span { display: none; }
		.travel-window__viewer { aspect-ratio: 4/5; }
		.travel-window__frame { inset: .8rem; }
		.travel-window__location { top: 1.25rem; left: 1.25rem; font-size: .66rem; }
		.travel-window__caption { left: 1.25rem; bottom: 1.4rem; right: 7.5rem; }
		.travel-window__caption p { font-size: .96rem; }
		.travel-window__controls { bottom: 1.5rem; right: 1.2rem; gap: .25rem; }
		.travel-window__bottom { flex-direction: column-reverse; align-items: flex-start; gap: .6rem; }
		.travel-window__thumbnails { width: 100%; gap: .3rem; justify-content: space-between; }
		.travel-window__thumbnails button { flex-basis: calc((100% - 2rem)/6); max-width: 4rem; height: 3rem; }
		.travel-window__note br { display: none; }
	}
	@media (prefers-reduced-motion: reduce) { .travel-window__controls button, .travel-window__thumbnails button, .travel-window__view { transition: none; } }
</style>
