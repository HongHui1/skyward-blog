---
import { skyCityPixels, PIXEL_SIZE } from "@/utils/pixel-word";
import { voxelFaces } from "@/utils/pixel-scene";
const pixels = skyCityPixels();
---

<!-- Real 3D earth lettering, grass and fireflies. SVG is the no-WebGL fallback. -->
<sky-pixel-signature class="pixel-signature">
	<div class="pixel-signature__stage" data-pixel-stage role="img" aria-label="SkyCity 自然微景观：立体泥土字、青草、野花与飞舞的萤火虫">
		<svg class="pixel-signature__fallback" viewBox="0 0 640 220" aria-hidden="true">
			{pixels.map((pixel) => <g style={`--pixel-hue:${pixel.hue}`}>
				{voxelFaces(pixel.x, pixel.y, PIXEL_SIZE).map((face, index) => <polygon points={face.map((point) => `${point.x},${point.y}`).join(" ")} class={`pixel-face-${index}`} />)}
			</g>)}
		</svg>
		<canvas aria-hidden="true"></canvas>
	</div>
	<div class="pixel-signature__caption">
		<p>故事还在继续，下次见。</p>
		<div class="pixel-signature__controls" hidden>
			<span class="pixel-signature__hint">风过草木，微光不息</span>
			<button type="button" data-pixel-pause aria-pressed="false">暂停动效</button>
		</div>
	</div>
</sky-pixel-signature>

<script>
	import "@/scripts/pixel-signature";
</script>

<style>
	.pixel-signature { display: block; width: 100%; max-width: 880px; margin: 0 auto 2rem; }
	.pixel-signature__stage { position: relative; display: block; width: 100%; height: clamp(230px, 31vw, 370px); background: transparent; touch-action: pan-y; }
	.pixel-signature__stage > :is(svg, canvas) { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; }
	.pixel-signature__fallback polygon { fill: #99794e; }
	.pixel-signature__fallback .pixel-face-0 { fill: #75904a; }
	.pixel-signature__fallback .pixel-face-1 { fill: #5b4835; }
	:global(.dark) .pixel-signature__fallback polygon { fill: #9c967d; }
	.pixel-signature canvas { visibility: hidden; }
	.pixel-signature[data-ready] canvas { visibility: visible; }
	.pixel-signature[data-ready] .pixel-signature__fallback { visibility: hidden; }
	.pixel-signature__caption { text-align: center; margin-top: .65rem; position: relative; }
	.pixel-signature__caption p { color: var(--sky-ink); font-size: .95rem; line-height: 1.8; margin: 0 0 .3rem; }
	.pixel-signature__controls { display: flex; align-items: center; justify-content: center; gap: 1.15rem; flex-wrap: wrap; }
	.pixel-signature__controls[hidden] { display: none; }
	.pixel-signature__hint { color: var(--pixel-caption, #526276); font-size: .75rem; }
	:global(.dark) .pixel-signature { --pixel-caption: #b4c3d4; }
	.pixel-signature__controls button { min-height: 44px; padding: .5rem .75rem; color: var(--pixel-caption, #526276); font-size: .75rem; border-radius: 6px; text-underline-offset: 4px; cursor: pointer; }
	.pixel-signature__controls button:hover { text-decoration: underline; color: var(--sky-ink); }
	.pixel-signature__controls button:disabled { cursor: default; text-decoration: none; }
	.pixel-signature button:focus-visible { outline: 2px solid var(--primary); outline-offset: 3px; }
	@media (max-width: 600px) {
		.pixel-signature { margin-bottom: 1.2rem; }
		.pixel-signature__stage { height: 195px; }
		.pixel-signature__caption { margin-top: 0; }
		.pixel-signature__controls { gap: .35rem; }
		.pixel-signature__hint { font-size: .72rem; }
	}
</style>
